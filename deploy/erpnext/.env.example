# Official Frappe Docker image. Pin the major/minor version for reproducible
# deployments; update only after taking a verified database backup.
ERPNEXT_VERSION=v16.31.1

# Generate a unique value on the server. Never commit the real file.
DB_PASSWORD=replace-with-a-long-random-database-password

# Low-concurrency profile for the current 4 CPU / 4 GB class VM.
GUNICORN_THREADS=2
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=180

# Temporary test hostname. Replace with erp.<your-domain> for formal rollout.
FRAPPE_SITE_NAME_HEADER=erp.124.223.87.161.nip.io
UPSTREAM_REAL_IP_ADDRESS=172.16.0.0/12
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=on
PROXY_READ_TIMEOUT=300
CLIENT_MAX_BODY_SIZE=100m
