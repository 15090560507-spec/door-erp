JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ADMIN_PASSWORD=replace-with-a-strong-admin-password
CORS_ORIGINS=http://localhost:3000,https://your-domain.example

# The retired local production/ERPNext workflow stays read-only and hidden by default.
LEGACY_PRODUCTION_ENABLED=false

# ERPNext bridge. Keep credentials only in the server .env file.
ERPNEXT_ENABLED=false
# The backend reaches the proxy over the Docker network; the browser uses PUBLIC_URL.
ERPNEXT_BASE_URL=https://door-https-proxy:8443
ERPNEXT_PUBLIC_URL=https://124.223.87.161:8443
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_COMPANY=
ERPNEXT_CUSTOMER_GROUP=
ERPNEXT_TERRITORY=
ERPNEXT_ITEM_GROUP=
ERPNEXT_TIMEOUT_SECONDS=90
# Set false only while ERPNext still uses its bootstrap self-signed certificate.
ERPNEXT_VERIFY_TLS=true
